{
  "name": "Comfy-APP-T3 API",
  "entryPoints": [
    "src/lib/**/!(*.test).ts",
    "src/server/**/!(*.test).ts",
    "src/trpc/**/!(*.test).ts",
    "src/trpc/**/!(*.test).tsx",
    "scripts/db-backup-core.mjs"
  ],
  "out": "docs/api",
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/node_modules/**",
    "**/workflows/**"
  ],
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "readme": "none",
  "searchInComments": true,
  "externalSymbolLinkMappings": {
    "@types/node": {
      "\"child_process\".spawn": "#"
    }
  }
}
