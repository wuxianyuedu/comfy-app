{
  "name": "Comfy-APP-T3 API",
  "entryPoints": [
    "src/lib/**/!(*.test).ts",
    "src/server/**/!(*.test).ts",
    "src/trpc/**/!(*.test).ts"
  ],
  "out": "docs/api",
  "exclude": [
    "**/*.test.ts",
    "**/node_modules/**",
    "**/workflows/**"
  ],
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "readme": "none",
  "searchInComments": true
}
