#!/bin/sh
# 提交门槛(2026-08-29):结构硬规则 + 类型检查 + lint + UI/逻辑分离棘轮 +
# React 函数式 updater 纯净性硬规则(ISSUE #141) + import 别名统一(ISSUE #640)。
# 临时绕过用 git commit --no-verify(慎用,绕过会进历史)。
# 2026-09-02: npx → pnpm exec。本项目使用 pnpm 管理 node_modules，
# npx/npm 在该环境下解析 .bin 别名链（typescript → typescript6/7）会崩溃，
# 且 npx 可能触发与 pnpm 布局不一致的隐式安装。
# master 分支只接受「分支开发 → PR → 合并」的变更(规范 13.6)。
# 放在最前:分支不对时不必再跑 tsc/lint —— 那些检查的结果最后都会被丢弃。
echo "[pre-commit] 1/24 master 分支提交守卫"
node scripts/check-branch-guard.cjs || exit 1

echo "[pre-commit] 2/24 文件结构硬规则（R1-R6/R7-R12）"
# R5 的棘轮（超 900 行文件）需要 --strict 才判定,这里保持「只提醒」,与其余棘轮
# （重复块 / 函数长度 / 主题色）的本地口径一致 —— 被拦下的动作要求拆分文件,
# 不适合在本地每次提交都挡一次。
# ⚠️ 遗留：平台侧流水线（.cnb.yml）删除后,R5 棘轮的 --strict 判定不在这里执行
# （规范 13.5.3）。它的去处是「按需召唤」（规范 13.5.4）:在 PR / Issue 里 @ 评审
# NPC 跑一轮,不 @ 就不跑 —— 不是把 .cnb.yml 贴回去。要恢复成本地每提交都跑,
# 先按提示把超基线的文件拆到位,再给这一步加上 --strict。
node scripts/check-file-structure.cjs || exit 1

# 2026-09-15(ISSUE #562): 跨平台动作对照表（规范 §9.5）。
# Windows 入口是 .ps1（§8），Linux / macOS 跑不了 .ps1 —— 同一个动作因此在两侧
# 各有一份实现。启动编排已经栽过一次（Windows 一条 .ps1 链、POSIX 一条 .mjs 链
# 各自演进，四项行为静默分叉），所以「新增动作必须两侧都在」与「会失效的清单
# 只许定义一次」都机器化：新增 .mjs 忘了登记、或在 .ps1 里又抄一份
# KNOWN_FAILED_FILES，都在这里被拦下。
echo "[pre-commit] 3/24 跨平台动作对照（.ps1 ⇄ .mjs）"
node scripts/check-ps1-consistency.mjs || exit 1

echo "[pre-commit] 4/24 React 函数式 updater 纯净性(ISSUE #141)"
node scripts/check-react-updater-purity.cjs || exit 1

# 2026-09-11(ISSUE #310 弹窗类回归): 标题行(页签栏)让位。
# 页签搬到窗口标题行后，任何 `fixed inset-0` 的顶层浮层都会把页签和右上角
# 窗口按钮一起盖住；首轮修复只改了全屏视图、弹窗类漏改。这条把判据机器化。
echo "[pre-commit] 5/24 标题行让位硬规则"
node scripts/check-title-bar-clearance.cjs || exit 1

echo "[pre-commit] 6/24 tsc --noEmit"
pnpm exec tsc --noEmit || exit 1

# 2026-09-10(ISSUE #322): eslint 统一为**零警告**口径。
# 此前本地只判「无 error」，而门禁另一侧判 --max-warnings 0 —— 结果是 warning
# 能在本地顺利进历史，直到更晚才被拦下（复核返工）。规范 11.7 / 13.5 的门禁
# 一律零警告，本地与其它运行位置必须同一口径。
# 平台侧流水线（.cnb.yml）已按额度约束删除（ISSUE #623），这条钩子现在是
# **唯一**跑门禁的地方 —— 见规范 13.5 / 13.5.3。按需那一层（全量单测 / 构建护栏 /
# E2E）走「@ 评审 NPC 唤起一轮」,不写配置、不花核时,见规范 13.5.4。
echo "[pre-commit] 7/24 eslint（零警告）"
pnpm exec eslint . --max-warnings 0 || exit 1

# 2026-09-04: UI 与逻辑分离棘轮(规范 17)。违规数只许降不许升:
# 新增 fetch / vanillaApi / tRPC hook 进视图层 → 阻断;
# 治理后指标下降 → 提示执行 --update 收紧基线(不阻断,避免打断提交)。
echo "[pre-commit] 8/24 UI/逻辑分离棘轮"
node scripts/check-ui-logic-separation.cjs || exit 1

# 2026-09-12(ISSUE #408): CHANGELOG 碎片形态。
# CHANGELOG.md 的 [Unreleased] 是「人人都改同一处」的文件,并行分支必然冲突;
# 改为一件变更一个 changelog.d/ 碎片(见规范 13.10.5)后,这里守住碎片的
# 文件名与段落标题口径——碎片写歪了会在发版并入时才暴露,那时已难追溯。
echo "[pre-commit] 9/24 CHANGELOG 碎片"
node scripts/check-changelog-fragments.cjs || exit 1

# 2026-09-14(ISSUE #489 缺陷 4): 端口推导的跨语言一致性。
# 规范 §1.1 承诺「Node / PowerShell / Python / Rust 四侧对同一路径给出同一端口」,
# 但此前四侧各写各的固定断言,没有任何测试会发现某侧漂移。改为四侧读同一份共享
# 校验向量(tests/fixtures/app-port-vectors.json),任一侧漂移即在此拦下。
# 2026-09-16(ISSUE #640): import 别名统一（规范 §12.2 / §16.2）。
# 本仓库的别名约定是 `~` 前缀，但 `tsconfig.json` 的 paths 里同时留着 `@/*`
# （create-t3-app 脚手架的历史项）—— 于是 `@/` 也能编译、也能跑，没有任何反馈，
# 漂移面积自己变大。`shadcn add` 生成的组件默认写 `@/`（§16.3 已点名），
# src/components/ui/ 因此是重灾区；而 ui/ 是「工具生成、不手改」的目录，
# 靠人改不现实。判据机器化后，顺手改一处就是顺手的事。
echo "[pre-commit] 10/24 import 别名统一（~ 前缀）"
node scripts/check-import-alias.cjs || exit 1

echo "[pre-commit] 11/24 端口推导跨语言一致性"
node scripts/check-app-port-vectors.cjs || exit 1

# 2026-09-14(ISSUE #75 主题专项): 主题色扫描棘轮。
# 「类型色例外」此前只写在规范与 globals.css 注释里,是人读的口径 —— 扫描器
# 没有机器可读的豁免清单,于是同一批类型色(端口类型色/节点类别色/参数分组色)
# 每轮扫描都被当漏网再报一遍。这条把豁免显式化,未豁免的写死色值走棘轮
# (只许降不许升),新写的写死色值一律阻断。
echo "[pre-commit] 12/24 主题色扫描棘轮"
node scripts/check-theme-colors.cjs || exit 1

# 2026-09-14(ISSUE #536 P2): 跨文件重复块(规范 12.12)。
# 历史上两份「同一能力的不同入口」各自复制了一份协议实现(84% 逐行相同),而
# review 单看每一份都「没毛病」—— 只有并排比较才发现是同一段。这里把它机器化:
# 新增孪生对即阻断,存量修掉后收紧基线。
# 2026-09-14(ISSUE #534 P1): ComfyUI 端口口径一致性。
# 「默认端口」此前有四五份实现（连接侧硬编码 8188、拉起侧靠「>0 才传 --port」、
# config.ts 的 schema 默认值、错误文案），彼此从未对过。单看每一处都「没毛病」，
# 只有并排比较才发现是同一件事的不同口径 —— 与跨文件重复块同族，故放在一起。
# 分叉的表现不是「连不上」，而是静默连到另一个实例（现象是上传失败/端口漂移）。
echo "[pre-commit] 13/24 ComfyUI 端口口径一致性"
node scripts/check-comfyui-port-contract.cjs || exit 1

# 2026-09-14(ISSUE #534 P3): 视图层不得动态注入 <style>(规范 03 §3.5 / 反模式 T5)。
# 本仓库踩过两次、形态一样(组件私有 CSS 字符串 + 渲染时注入):WorkflowEditorCanvas
# 与 studio/ui/CodeBlock。前者改完只留了注释,后者又犯一遍 —— 「自己修完自己写
# 注释」挡不住下一个人,故把判据机器化。
echo "[pre-commit] 14/24 内联样式注入"
node scripts/check-inline-style.cjs || exit 1

echo "[pre-commit] 15/24 跨文件重复块"
node scripts/check-code-duplication.cjs || exit 1

# 2026-09-14(ISSUE #536 P4): 函数长度(规范 12.13)。
# 文件行数由 R5 管,函数没人管 —— 于是 2186 行的单函数一路合法存在。这里按
# 「每个文件超阈值的函数数」记账,棘轮只许降不许升。
# 2026-09-15(ISSUE #570 第 7 项): 无名字的块体(IIFE / 回调 / 闭包)与跨行签名
# 同受约束(规范 12 §12.13.2)—— 此前「把 300 行塞进 IIFE 里」能整条绕过本门禁。
echo "[pre-commit] 16/24 函数长度棘轮"
node scripts/check-function-length.cjs || exit 1

# 2026-09-14(ISSUE #536 P4): Rust 函数长度（规范 12.13）。
# §12.13 的 TS/TSX 门禁扫不到 Rust —— 于是 lib.rs 的 run() 里塞了近 300 行的
# 窗口/托盘/协议/sidecar 编排，没有任何机器信号。这条把 Rust 侧同一维度补上，
# 阈值 120（Rust 是结构化编排，自然长度比 TSX 短），同样走棘轮。
echo "[pre-commit] 17/24 Rust 函数长度棘轮"
node scripts/check-rust-function-length.cjs || exit 1

# 2026-09-15(ISSUE #568): core 骨架的单一事实源。
# 三处承诺此前都只写在注释里，而注释与现状恰好相反（DI 容器只有 2 个调用方、
# 30+ 处直接读 process.env、日志有两条通道且其中一条零脱敏）。本仓库的教训是
# 「判据不接门禁就等于没有判据」，因此这三条各自配机器判据。
echo "[pre-commit] 18/24 core 骨架单一事实源"
pnpm exec vitest run tests/single-logger-channel.test.ts tests/container-single-access.test.ts tests/core-spine-single-source.test.ts || exit 1

# 2026-09-15(ISSUE #574): 模块循环依赖（规范 12.7）。
# src/lib 内曾有 2 组真实环（executor 家族 4 文件互相递归、comfyui 状态探测
# 3 文件成环），只靠一句注释「加载期是安全的」维持、没有任何测试。环的症状是
# 「import 顺序变了就 undefined is not a function」，排查成本极高，因此把
# 「无环」做成棘轮：新增环即阻断，消除一个就 --update 收紧一次。
echo "[pre-commit] 19/24 模块循环依赖棘轮"
node scripts/check-circular-deps.cjs || exit 1

# 2026-09-15(ISSUE #572 第 1 项 / 规范 §18.4): src/lib 的 Node-only 声明与可达性。
# 三套写法（.server.ts / server-only / 都没有）并存了很久，而「都没有」那一类
# 真的出过整页 500（log-session-scope 顶层 node:fs 被客户端组件引到，ISSUE #317）。
# 判据不是「扫到 fs 就要求 server-only」—— 那会误伤「纯 Node 宿主」（它的入口是
# 一句 throw，加上去 scripts/*.mjs 的启动编排会直接崩），而是走依赖图判三件事：
# 声明缺失 / 声明失效（假声明）/ 真被 "use client" 入口引到。
echo "[pre-commit] 20/24 src/lib Node-only 声明与可达性"
pnpm exec vitest run tests/lib-node-only-declarations.test.ts || exit 1

# 2026-09-15(ISSUE #575 第 9 项 / 规范 §13.5): prettier 格式棘轮。
# `format:check` 长期是唯一没进门禁的既有质量命令 —— 全库 576 个文件未过,
# 一次性 --write 会产生与本次改动无关的全文件 diff(违反 §13.7)。但「等基线
# 整改完再接入」的代价是每个新文件都能带任意格式进来,存量只增不减,那一天
# 永远不会到。判据改为**基线 + 只许下降**:新增脏文件即阻断,存量修掉后
# 提示收紧基线(--strict 下要求必须收紧)。
echo "[pre-commit] 21/24 prettier 格式棘轮"
node scripts/check-format.cjs || exit 1

# 2026-09-15(ISSUE #575 第 9 项 / 规范 §13.5): 格式化提交与行为改动分离。
# 格式棘轮只判「文件干不干净」,管不住「顺手全库 format:write」—— 那会把一次
# 真实改动埋在几百个文件的重排里,`git blame` 当场失效、评审看不出改了什么。
# 这条判**提交形态**:某文件的改动若「过一遍 prettier 就变成另一种写法」,
# 即视为纯格式化;一次提交里这种文件 ≥ 10 个就阻断,要求拆成两次提交。
# 阈值取 10:顺手格式化一两个文件是正常操作,拦在 1 会让门禁变成噪声源。
echo "[pre-commit] 22/24 格式化提交与行为改动分离"
node scripts/check-reformat-only.cjs || exit 1

# 2026-09-16(ISSUE #573 第 9 项 / 规范 §12.16): src/lib 的零消费值导出。
# §12.15 给了「死代码该接线还是该删」的口径，但**没有判据** —— 那批 Result /
# 零 new 调用点的错误类 / eventBus 全是人工读出来的，读完就又开始长。这条只认
# **值导出**（type/interface 不算：566 个「零引用」里 90% 是同文件内使用的 props
# 类型，纳入只是噪音），按符号记棘轮、只许降不许升，登记项反向核对。
echo "[pre-commit] 23/24 src/lib 零消费导出棘轮"
node scripts/check-dead-exports.cjs || exit 1

# 2026-09-16(ISSUE #565): core 的「出口纪律」与基类纯度。
# `core/index.ts` 曾是四个 `export *` 的 barrel，注释写着「所有 server 端模块都从
# 这里取」—— 而全库只有 2 处真的这样导入，实际口径是深路径。假承诺的代价是下一个人
# 照着写就多出一种取法（与已删除的 container 同款）。`repository-base.ts` 同理：
# 它在基类里打了一条日志，把口径钉死在基类，并让没有日志设施的宿主连带加载 pino。
# 两条此前都只写在注释里、没有判据，因此这里各配一条机器判据。
echo "[pre-commit] 24/24 core 出口纪律与基类纯度"
pnpm exec vitest run tests/core-barrel-entry-discipline.test.ts tests/repository-base-purity.test.ts || exit 1

echo "[pre-commit] 全部通过 ✓"
