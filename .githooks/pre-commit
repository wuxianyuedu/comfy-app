#!/bin/sh
# 提交门槛（2026-09-22 并行化重排）：结构硬规则 + 类型检查 + lint + UI/逻辑分离硬闸
# + 一批「同一件事只允许一处实现」的机器判据 + CHANGELOG 碎片。
#
# 判据内容与各步语义与旧版逐条一致，只改了「执行编排」：
#   旧版除 tsc‖eslint 外，23 个 check-*.cjs + 3 次 vitest 全**串行**，单次提交实测约
#   6 分钟。现按「互不依赖」分成 4 组并行：A=tsc、B=eslint、C=合并后的**一次** vitest
#   （旧版是 3 次独立 pnpm exec vitest run，各付一次 vite 冷启，实测 46+14+11=70s →
#   合并 26s）、D=其余静态检查（组内仍串行，避免一次起几十个 node 抢内存）。
#   D 组这条「组内串行」是**实测过的有意取舍**，不是没量过的直觉（ISSUE #1610）：
#   隔离档 20.3s / 484MB，在真钩子里却要 ≈44s —— 那 20s 是「8 核闲着、并发吃掉 idle
#   核」，而真钩子里 C（4 个 vitest worker）+ A（tsc）+ B（eslint）已经把核占满，
#   D 改并发把同一批核重新分配一次，wall 净零（44.7 / 43.6 / 44.1 / 43.6s 对 44.3s）
#   而峰值照涨 0.3GB ⇒ **D 组在真钩子档不该并发**；隔离跑 / 本地体检可以并发，4 是
#   最优档（8 更慢更占内存）。D 组真正贵的是「13.2s 里 90% 是串行 spawn 50 次
#   prettier」——那条已按判据等价改成整批口径（`check-reformat-only.cjs`，
#   59 个改动文件 15.2s → 2.0s），与并发无关，也别为了它动这里的串行。
#   完整结论与「隔离跑可以并发、为什么真钩子里不行」见规范 §13.5.8.1。
#   wall ≈ max(各组) 而非求和；内存仍受控在 ~4 个并发。任一非零仍阻断提交（口径不变）。
#
# ── 后来又加了一档 D0：形态前置档（串行，在 A/B/C/D 启动之前跑完）─────────────
# 上面那笔「D 组不该并发」的账反过来还有一层意思，这里把它说明白，因为两件事读起来
# 像互相矛盾：**D 组内部把便宜的挪到前面，也不会让任何一次提交变快**。理由是收尾那个
# `for id in A B C D; do wait` —— 四组并行且**全部等完**，所以墙钟 = max(各组) = C 组，
# 与 D 内部的顺序无关：结论早到了，人还是站在同一堵墙前面。
#
# 真正被浪费的是**红的那几次**（本机账：`.git/comfy-precommit-timing.jsonl` 最近 17 次
# 提交，6 次红）。D 组带 `set -e`，所以一次红的记录里「记到哪一条」就是**拦下你的那一条**
# （后面的没有跑）。⚠️ 读这份账时先记住一件事：**失败那一条自己以前不进账** ——
# `set -e` 在 `timed_step` 的 printf 之前就把组截断了，于是「最后一条」其实是拦下者
# **前面**那一条。本轮已修（见 `.githooks/timing.sh` 里 `"$@" || _ts_rc=$?` 那处），
# 下面这份归属是按修好之后的口径念的。
#   · 三次是「每档都有主（新鲜度账）」—— 跨过一个 00:00 之后的第一次提交，而它在 D 里排得很后；
#   · 两次是「生成态文档与源同步」—— 它已随 ISSUE #1975 挪到平台侧，本地不再付这笔；
#   · 一次是「CHANGELOG 碎片」：**D 跑到 14.2s 就已判红，而整条钩子照旧付满 C 的 156.6s
#     才退出**（账里那条：exit 1、D=14.2s、C=156.6s、总 157.6s）。
#   ⇒ 能省钱的形状只有一个：**在启动 A/B/C 之前**先拿到这一档结论。也就是串行前置，
#     不是并发编排、也不是组内重排。D0 就是为此存在的。
#
# 谁进 D0（两条都满足，缺一条就留在 D 的并行档里）：
#   ① 判的是**这次提交自身的形态** —— 暂存的内容 / 提交元数据 / 登记台账；违例的修法是
#      「改你刚 stage 的东西」，不依赖其它组的结论，也不是「等测试告诉你为什么」；
#   ② 落在**整组预算**里。这一档是串行的 ⇒ 它的墙钟就是全部入选判据之和（并行档不是），
#      所以预算按**组**算而不是按条算：一次真实绿提交的读数是 **D0 组 16.1s（步之和 15.4s）**。
#      按条筛会把「一条就吃掉整份预算」的判据放进来 —— 逐条的耗时基线见
#      `docs/audits/2026-10-16-hook-baseline-map.md`（那份快照的中位与本钩子文件的账跨着
#      不同的负载窗口，差几倍是常态）：`文件结构硬规则(R1-R12，R5 硬闸)` 9.4s、
#      `jsx-a11y 规则开关⇄判据（§6.12）` **31.3s —— 单它一条就超过整份预算**。
#      这两条**明知同属「形态」这一族**也刻意留在 D 里：贵的判据放在并行档里是**免费**的
#      （反正墙钟由 C 决定），挪进串行前置档就是给每一次绿提交加税。
#
# 「墙钟其实由 C 组决定」这件事不是本档的新发现，那份基线快照已经用 9 个样本量过并写成
# 结论（含「动 D 组省不了墙钟」那句推论）—— 本档新增的只有**红的那几次**那一格：
# 并行档里迟到 87–233s 的形态错，仍然要付满 C 组的墙钟。
#
# 这一档的代价与收益都是实测的，不是「显然更快」：一次真实绿提交里 **D0 组 16.1s**
# （步之和 15.4s）⇒ 绿提交的墙钟 141s 变 ≈157s（约 +11%），换来那 6/17 的形态红
# 从 157–3630s 变 ≈16s。**这是拿绿档换红档的取舍**，写下它是因为它会被人当成免费午餐而
# 继续往里加东西。
# ⚠️ 这个数字原本有一多半是**取时钟的钱**（每步两次 `$(date +%s%3N)`，MSYS 上每次 fork 约
# 467ms）—— 那是记账开销、不是判据成本，已按 `timing.sh` 新增的 `set_now_ms` 收掉。
# 同一方法的对照（把本档正文抽出来单跑，落在负载更重的那个窗口）：修前整组 54.0s / 步之和
# 41.1s，修后 25.0s / 26.2s ⇒ **组墙钟与步之和从此基本重合**（差 <1s），剩下的才是判据自己。
# **读数口径因此变了**：本轮之前的逐步账每条都含着 ≈0.5–0.9s 的取钟开销，跨这条线对比要记得。
#
# 新增判据的落点：判「这次提交自身的形态」且落在上面那份整组预算里 → 进 D0（顺序按实测命中率排）；
# 其余与既有静态判据互不依赖的 → 追加进 D 组（组内串行，顺序即执行序）；
# 需要另起 vite 的测试 → 并入 C 组的同一行 vitest run（别新起一次，那正是本次要消掉的
# 开销）。基线与旧版的步号已无意义，脚本自身的注释与规范章节才是指路牌。
#
# 保留的坑位注释：npx→pnpm exec（typescript 别名链 npx 会崩）；master 只走 PR（规范 13.6，
# 故分支守卫最先跑、错了不必再耗 tsc/lint）；eslint 零警告口径；tsc/eslint 各建一份 TS
# 程序、并发吃内存。**机器紧张时压并发的口子**：`COMFY_PRECOMMIT_MAX_WORKERS=1`
# （`run-affected-tests.mjs` 认这个变量，只调并发、不碰任何判据；缺省 4）——
# 2026-10-20 起 C 组本地不跑了，这个口子的主战场换到平台侧
# `scripts/ci-affected-tests.mjs`（并发按 `ci-load.mjs` 的现场核数收敛，见那里）。
# 为什么不建议改这条钩子本身：口径与实测曲线见规范 §13.5.8.1。
# --no-verify 绕过会进历史，慎用。
set -u

# ── 计时：每一次提交的墙钟留在本机（规范 §13.5.8.3）──────────────────────
# 记账收在 `scripts/precommit-timing.mjs`（落 `.git/`、不入库），这里只负责**测**。
# 口径三条：
#   · **只记账、不阻断**：记账自己失败（没 git、盘满、文件被锁）只是少一行账，
#     绝不影响提交的退出码 —— 一条记账线路变成提交的必经之路，迟早有人为它 --no-verify。
#   · **毫秒时钟要跨平台**：GNU date（Linux / git-bash）的 `%N` 给纳秒，BSD/macOS 的
#     date **不认 `%N`**（原样吐出那两个字）。探测一次，退化到「秒 × 1000」。
#   · 组/步的读数落 `$LOGD` 下的小文件（各子 shell 各写各的，不争同一处）。
# `now_ms` 与 D 组用的 `timed_step` 收在 `.githooks/timing.sh`：D 组跑在 `sh -c` 起的
# **新 shell** 里，外层函数它看不到，而两份时钟必然漂成两个刻度。路径经环境变量传进去
# （`sh -c` 继承环境），两处因此 source 同一份。
# `$0` 在 git 调钩子时是本钩子的绝对路径（git 用完整路径 exec 它），所以 `dirname $0`
# 就是 `.githooks/` —— 不用假定当前目录（钩子的 cwd 才是仓库根，两者不能混）。
# `COMFY_TIMING_SH` 与 `LOGD` 都要 `export`：D 组跑在 `sh -c` 起的**新 shell** 里，
# 未导出的 shell 变量它看不到 —— 读不到 `$LOGD` 时的形态是「逐步读数落到一个空路径」，
# 静默地丢掉整组逐步骤的账（第一版就是这么错的）。
COMFY_TIMING_SH="$(dirname "$0")/timing.sh"
. "$COMFY_TIMING_SH"
export COMFY_TIMING_SH

# ── 0. 分支守卫：最先、同步跑（分支不对时后面全白跑）────────────────────
echo "[pre-commit] 0  master 分支提交守卫"
node scripts/check-branch-guard.cjs || exit 1

# 各组输出写到各自日志，跑完再按组归属打印（并行 stdout 交错的补救）。
LOGD="$(mktemp -d "${TMPDIR:-/tmp}/comfy-precommit.XXXXXX")" || exit 1
export LOGD

# 总计时起点。记在 `$LOGD` 外面只有一处用途：**记账**（见 record_timing）。
set_now_ms _T0_MS

# 记账：把本次的墙钟交给 `scripts/precommit-timing.mjs`（它只写 `.git/`、不入库）。
# 放在 trap 里而不是收尾那一行 —— **被拦下的那次提交恰恰是最该被记的**
# （「为什么这次要我重跑」的答案就在时长里），而拦下走的是 `exit 1`，收尾那一行到不了。
# 幂等：收尾已经记过就置空，避免两条记录。
record_timing() {
  [ -n "${_RECORDED:-}" ] && return 0
  _RECORDED=1
  set_now_ms _end
  _total=$(( _end - _T0_MS ))
  set -- --total-ms "$_total" --exit "${rc:-0}" --staged "${_STAGED_N:-0}"
  # `D0` 排在最后而不是按字母序：账本按这个顺序打表，而 D0 是「先跑完的那一档」，
  # 把它摆在四组之后读起来正好是「前置档 + 四个并行档」的形状。
  for id in A B C D D0; do
    [ -f "$LOGD/$id.ms" ] && set -- "$@" --group "$id=$(cat "$LOGD/$id.ms")"
  done
  if [ -f "$LOGD/steps.ms" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] && set -- "$@" --step "$line"
    done <"$LOGD/steps.ms"
  fi
  # 组 C 的分文件耗时读数：vitest 的 junit XML 与清单都落在 `$LOGD` 里（上面那个
  # trap 删的就是它，所以它不会留在检出里）。这里**只递目录** —— 解析在读账脚本里
  # 做：shell 里解析 XML 就是第二份实现，而两份的漂移形态是静默的（同 `timing.sh`
  # 那份时钟只留一处的同一条理由）。这一格只补读数，判定一个字没动。
  [ -d "$LOGD" ] && set -- "$@" --junit-dir "$LOGD"
  node scripts/precommit-timing.mjs record "$@" || true
}

trap 'rc=$?; record_timing; rm -rf "$LOGD"' EXIT INT TERM

# 本次暂存了多少个文件 —— 「耗时随改动面涨」这条要对上账，只有时长没有面就是半条账。
_STAGED_N="$(git diff --cached --name-only 2>/dev/null | wc -l | tr -d " ")"

# run_group <id> <说明> <命令…>：后台跑一个组，rc 落文件，末尾统一判定。
run_group() {
  id="$1"; desc="$2"; shift 2
  # ── 组 C：执行者已挪到平台侧（2026-10-20），本地一律不执行 ────────────────
  # 它与 A/B/D 的「降档」不是一件事：`COMFY_HEAVY_GATES=1` 也换不回来。
  # 立案现场：会起 vitest 子进程的这一档在共享机上的失效形态**不是用例红**，而是
  # `Failed to start forks worker / Timeout waiting for worker` —— 另一条检出并发推
  # 自己的分支 + 多个 dev server 抢核时，pre-push 的受影响用例档被这种调度超时拦下，
  # 而隔离复跑 88 个用例文件 / 1116 条全绿。也就是说本地这一跳在最需要它给出结论的
  # 机器上，给的恰是最不可信的读数。
  # 新执行者：`.cnb.yml` 的 `受影响用例` 那一格（`scripts/ci-affected-tests.mjs` →
  # `run-affected-tests.mjs` + `COMFY_AFFECTED_CHANGED`，**同一条判决链**；并发按
  # `ci-load.mjs` 的现场核数收敛，超时形态的隔离复跑话术仍由启动器自己负责）。
  # ⚠️ 这一段**留着不删**：`tests/hook-affected-launch.test.ts` 钉的就是这个入口形状
  # （C 组必须走 `run-affected-tests.mjs`，不许退回 `pnpm exec vitest run $files`）。
  # 本地要跑受影响面：`pnpm check:all`（全量）或手工
  # `COMFY_AFFECTED_CHANGED=$'src/a.ts' node scripts/run-affected-tests.mjs`。
  if [ "$id" = "C" ]; then
    echo "skipped" >"$LOGD/$id.skip"
    echo "ci" >"$LOGD/$id.moved"
    return 0
  fi
  # ── 档位开关（ISSUE #2022）───────────────────────────────────────────────
  # 本地**提交**默认只跑 D0（形态前置档）：A(tsc) / B(eslint) / D(静态判据)
  # 这三组不再在每次提交上跑。**它们没有消失** —— 第一层接手是推送那一跳
  # （`.githooks/pre-push` → `check:premerge` 的 `base` 段），第二层是平台流水线
  # （规范 §13.5.25）。业主口径：提交在开发者的编辑循环里，慢 = 直接被 `--no-verify` 绕掉。
  # ⚠️ **这里的“不跑”只关执行时机，不关注册表**：那 54 条 `run "<标签>" <命令>` 步骤行
  # 逐字留在这份文件里，因为 `scripts/check-gate-executors.cjs` 是按**文本**解析本文件的
  # 三处出处之一（另两处是 `quality-gate.mjs` / `quality-gate.ps1`；`.cnb.yml` **不算**
  # 执行者）。把步骤删掉 = 那一族判据当场失去执行者 = 本仓最恨的静默删除。
  # 人要在本地跑 A/B/D（合并前自查、或怀疑 CI 那一份不可信）：
  # `COMFY_HEAVY_GATES=1 git commit …`，或 `pnpm check:all`。**C 组除外** ——
  # 它 2026-10-20 起整体挪去了平台侧，连这个开关也换不回来（见下面那段）。
  # 跳过不是通过：收尾那一段会把跳过的组**逐组点名**，
  # 所以账本与日志里读得出「这次提交本地没测行为面」，不会出现一次冒充全绿的绿钩子。
  if [ "$id" != "D0" ] && [ "${COMFY_HEAVY_GATES:-0}" != "1" ]; then
    echo "skipped" >"$LOGD/$id.skip"
    return 0
  fi
  (
    set_now_ms _g0
    echo "── 组 $id：$desc"
    "$@"
    _grc=$?
    set_now_ms _g1
    echo "$(( _g1 - _g0 ))" >"$LOGD/$id.ms"
    echo "$_grc" >"$LOGD/$id.rc"
  ) >"$LOGD/$id.log" 2>&1 &
  eval "${id}_pid=\$!"
}

# ── D0：形态前置档（串行，先于 A/B/C/D 启动）──────────────────────────────
# 入选口径（「判这次提交自身的形态」且落在**整组**预算里）、这笔税换来了什么，都记在文件头
# 那段「后来又加了一档 D0」。这里只留一条与顺序有关的口径：**本机账里真拦下过提交的
# 那两条排最前**（CHANGELOG 碎片 → 新鲜度账），其余按代价升序排。组内重排在**这一档**里
# 确实有用，而在 D 组里没有 —— 差别就是这一档的墙钟等于本组之和（串行），
# D 组的墙钟等于 max(四组)（并行）。
# `run()` 与 `timed_step` 都来自 `.githooks/timing.sh`，只定义一次：本钩子现在有两个
# 这种 `sh -c` 块，抄两份 `run()` 的漂移形态与那份文件头里「两份时钟必然漂成两个刻度」
# 同款（例如后来有人给其中一处加「跳过时不打标签」，两组的账就再也不能并排读）。
# 本组同样是 `sh -c` 起的新 shell ⇒ 必须自己 source 时钟，否则逐步读数静默消失。
run_group D0 "形态前置档（这次提交自身的形态）" sh -c '
  set -e
  . "$COMFY_TIMING_SH"
  # CHANGELOG.md 的 [Unreleased] 是「人人都改同一处」的文件,并行分支必然冲突;
  # 改为一件变更一个 changelog.d/ 碎片(见规范 13.10.5)后,这里守住碎片的文件名与
  # 段落标题口径——碎片写歪了会在发版并入时才暴露,那时已难追溯。
  run "CHANGELOG 碎片" node scripts/check-changelog-fragments.cjs
  # 待发段落([Unreleased])的**来源锚** ⇄ 条目归属(规范 §13.10.6)。
  # 上一行只管碎片**形态**(文件名 / 段落标题),不管它们被并到哪儿 —— 于是「并入没
  # 走完」是一种静默形态:被后一条推翻的旧条目留在 [Unreleased] 里(实测还在),
  # 而推翻它的碎片躺在 changelog.d/ 里没有东西提醒该并了。本步判三件:锚写了没有、
  # 锚解析不解析得开(**写歪比不写更贵**:歪锚会让识别正则回 null、整条判据静默放过)、
  # 同一 ISSUE 号有没有**跨锚分裂**(既在待发段落里、又在它之前的已发布段落里 ——
  # 那才是这条账最贵的失效形态:归属被切成两半而两端都没写错)。
  # 成本实测:纯文本 + 只读 git,零网络,< 0.3s。
  run "待发段落的来源锚 ⇄ 条目归属" node scripts/check-changelog-versions.cjs
  # 「改了 `SCOPED_DOCS` 的文档源，就必须同批带上 `docs/generated/**` 的镜像」。
  # 这一条为什么在本地、而它那两个同类判据（内容一致 ⇄ 引用权威）在平台：平台那格跑的是
  # `--check --autofix`，**就地修好再判**，所以「漏带镜像」在平台读数里从不出现，红只会
  # 落在下一个动文档面的 PR 上（实测 2026-10-21 一天复现三次，每次吃掉一次 CI 往返）。
  # 本步不读任何文档内容 —— 一次 `git diff --cached` 加一次集合比对，判的是提交的形态，
  # 那正是 D0 的本职；内容一致性仍归平台那格（那边才有 `pnpm doc:render` 的产物可写）。
  # 成本实测：纯本地、零网络，与上一行同量级（< 0.3s）。
  run "文档源 ⇄ 生成态镜像同批" node scripts/check-doc-mirror-pairing.cjs --staged
  # 「判据自身的数值」也要有账（ISSUE #2156）。`scripts/check-*.cjs` 那几十份判据把
  # 「什么算违规」钉在源码里的数值上，而**把这些数值调松没有任何一格会红** —— 一条只改
  # 阈值的 PR 可以本地全绿、CI 全绿，落进 master 之后那道闸对所有人事后失效。
  # 这一条不判代码，判「源码 ⇄ scripts/.gate-thresholds.json」：
  # 漂移即红（并说出是变松还是变严、方向逐条记 —— A 档阈值越大越松、B 档地板越小越危险），
  # 同组两把尺子必须同数，未入账的顶层数值也红。为什么在 D0：只读账上点名那批文件的头部
  # 常量、零网络，实测 0.34~0.49s（Node 起动占大头，读文件本身 8~12ms），而它必须在
  # 「改阈值那一笔」上就拦（挪到平台侧 = 红落在下一个动判据的人身上）。
  # 账里有多少条由脚本自己念，散文里不抄 —— 抄一份就会与判据文件漂移（ISSUE #1407 那一型）。
  run "判据自身的数值 ⇄ 账同批" node scripts/check-gate-thresholds.cjs
  # 为什么它在这一档而不是 D：本机那份账里 6 次红有 **3 次**是这一条拦下的（它判的是
  # 「这次提交欠哪一档的账」，读的正是暂存面，不依赖任何别的组的结论），而它在 D 组排得
  # 很后面 —— 付满 C 组的墙钟之后才知道自己今天还欠一次 e2e。
  # 每一档按需档都要**有主**（规范 §11.8 / §13.5.4）。本步判「每一登记档都有一条新鲜度
  # 记录，且写清谁 / 什么时候 / 按哪条命令复核的」（`scripts/.<档>-freshness.json`）——
  # 它**不跑**那些档（起 webServer / 全量单测 / next build 会与钩子里的 A/B/C/D 抢资源），
  # 只判「这一档上次被实证跑绿是什么时候」这件事有人回答过。
  #
  # ⚠️⚠️ **2026-10-19 起这一步只打读数、不再要求本地当天自证**（用户口径：「新鲜度都不要
  #   本地跑，都 CI 跑」）。机制是数据不是开关：`FRESHNESS_TRACKS[*].ciStage` 非空 ⇒
  #   「今天必须有凭证」那一层整层跳过，执行者是 `.cnb.yml` 每日那一条的三格
  #   （`每日单元测试` / `每日生产构建` / `每日全量E2E`）。
  #   **这个豁免只在「那一格真的每天在跑」时成立** —— 由
  #   `tests/no-platform-ci-config.test.ts` 判「每个非空 `ciStage` 都必须在
  #   `COMFYAPP_CI_DAILY_GATES` 里」；没有那一条，「本地不拦」就悄悄变成「谁都不跑」，
  #   而两边都是绿的（§11.23 那一族最坏的那种）。
  #   仍然照旧判的是**账面的形状**（`who` / `how` / `verifiedAt` / `trackedBy` 抄混）：
  #   撤掉的是「必须跑」，不是让读数可以假。将来任何一档失去平台侧执行者时，
  #   把它的 `ciStage` 清空就回到本地拦截 —— 那几支判据现在也由合成档打着，
  #   不会因为此刻三档都豁免而悄悄死掉。
  #
  # 「每档都有主」那一层有**三档**（ISSUE #1282 起逐档接上）：平台流水线删掉（ISSUE #623）
  # 之后一直没有执行者的两条判定档 —— **全量单测 + 覆盖率**与**产物级护栏**，
  # 以及**全量 e2e**。它们此前只写在 §13.5.3 的欠账表里（「按需手动跑」），
  # 而那句话没有任何东西在守。
  #   三档的形状由 `FRESHNESS_TRACKS` 的数据决定，判据一份实现，且现在**三档同形**：
  #   · 全量 e2e —— 吃 `src/` `e2e/` `playwright.config.ts` `next.config.js` `pnpm-lock.yaml`：
  #     当天动过这些面就必须今天证一次；没动过以七天为宽限。
  #     （它以前是「按本地日历日、不看面」那一档 —— 于是本检出 17 次提交里 6 次红有 3 次
  #     是一笔只动 `.githooks/` 或文档的提交欠一次全量 e2e，而那次跑与不跑结论都不变。
  #     口径与那一格的现场见 §11.8。）
  #   · 全量单测 + 覆盖率 / 产物级护栏 —— 十分钟量级、**没必要每天都跑**，同样按
  #     「**改了就当天跑**」判（吃 `src/`+`tests/` / 产物链那几个文件）。
  #     ⚠️ 上面那格的 ⚠️⚠️ 把这一条的**执行者**改走了：那两档（连同 e2e）现在登记着
  #     `ciStage`，这一层今天只打读数；这套口径本身没被删 —— 清空 `ciStage` 就回来，
  #     而那几支判据由合成档打着（不会因为此刻三档都豁免而悄悄死掉）。
  #   出路每档都是两条：跑一次（跑绿即记），或记一条写明理由的账 —— `--skip "<理由>"`
  #   是「今天故意不跑」（只替当天作证），`--dirty "<理由>"` 是「这次改动不吃这一档」
  #   （那是可被今天的提交**驳倒**的事实声明）。
  # 占位理由一律被拦（豁免不是绕过）；账文件还没入库时只提醒、不阻断（平台侧 squash 合并
  # 不跑本地钩子，硬规则 6）。
  run "每档都有主（新鲜度账：e2e / 全量单测 / 产物三档自证）" node scripts/freshness-gate.mjs
  # UI 与逻辑分离硬闸(规范 17)。S* 存量已清零(ISSUE #1811 收尾时从棘轮翻上来):
  # 视图层出现裸 fetch / vanillaApi.* / tRPC hook 即阻断 —— 没有基线、没有
  # `--update`，也就不存在「借余量偷偷新增」那条路。H1/H2 本来就是硬规则。
  run "UI/逻辑分离硬闸" node scripts/check-ui-logic-separation.cjs
  # 地基层(src/lib + src/trpc)的零消费值导出（规范 §12.16）：硬闸 —— 存量已清零。
  run "地基层零消费导出(硬闸)" node scripts/check-dead-exports.cjs --staged
  # 故事文件的枚举来源（规范 16 §16.2.3.2 / §11.8）：`cva()` 返回的是函数，
  # 运行时没有 `.variants` —— 写成 `Object.keys(xVariants.variants.轴)` 时 tsc 会红，
  # 而 Storybook 在**加载期**抛 `Cannot read properties of undefined`（侧栏有故事、
  # 画布一片空白）。判据还顺带核「手写清单没漏档」——首轮就这么漏了
  # `icon-sm` / `icon-lg` 两档（实测 46 处调用）。
  # 故事面的三件事（规范 16 §16.2.3.8）：`title` 缺了 Storybook 按路径自动生成条目
  # （落在侧栏哪个分组取决于推导规则）、真组件没接上（画布上摆的是适配件或别的
  # 东西）与同目录两套分组前缀（分组靠人写 title 维系，没有任何东西会告诉你漂了）。
  # 第四件「必填 props 没给 args」只判 `--changed`（本次暂存的故事文件）—— 存量里
  # 有一批正当形态（值在 render 里给 / 受控开关由 story 持有 / 注入层的 sourceName
  # 就是它的 args），逐条白名单会变成第二份赦免名单，所以口径是「只挡新增」。
  run "故事面（title / 接上真组件 / 分组一致 / 必填 props 的 args）" node scripts/storybook-check.mjs --changed
  # 产品版本号三处同步（ISSUE #1611 阶段三 D7）。同一个版本号手抄在 package.json /
  # src-tauri/tauri.conf.json / src-tauri/Cargo.toml 三处，而这**不是**「改名麻烦」——
  # tauri.conf.json 的版本在**编译期**内嵌进壳，也是 tauri-plugin-updater 判「更新新旧」
  # 的基准：只升 package.json 时安装包与更新判定还停在旧版本，用户看到「已是最新」，
  # 而三处今天恰好相等 ⇒ 第一次忘记升某处的那一刻起错位永久静默（没有任何东西会红）。
  # 这也是 P0-4（Sentry release）刻意**不取** package.json version 的同一个理由。
  # 判据只判「三处逐字相等 + 形态合法」，刻意不判「该不该升」（那是发布判断）。
  # 成本实测：读三个文件、零网络、零子进程，与 check-app-port-vectors 同档。
  run "产品版本号三处同步(D7)" node scripts/check-app-version.cjs
  # ui/ 定制标记 ⟺ 台账（规范 16 §16.8）：`ui/` 是工具生成目录,但本仓库在若干基元上
  # 做过有意改动(button 的语义变体与 ButtonLink、dialog 的 backdrop 与 popupClassName…),
  # 此前没有任何地方记着哪个不能覆盖 —— 实测 `shadcn add command` 会顺手覆盖
  # button/input/textarea/dialog 四个。这条把「改过的地方留痕」机器化:标记与
  # docs/standards/16 §16.8 的台账双向一致,零网络(不判断差异内容,只保证两边不脱节)。
  run "ui/ 定制标记与台账（§16.8）" node scripts/check-ui-customizations.cjs
  # 跨平台动作对照表（规范 §9.5）。Windows 入口是 .ps1（§8），Linux / macOS 跑不了
  # .ps1 —— 同一个动作因此在两侧各有一份实现。启动编排已经栽过一次（Windows 一条
  # .ps1 链、POSIX 一条 .mjs 链各自演进，四项行为静默分叉），所以「新增动作必须两侧
  # 都在」与「会失效的清单只许定义一次」都机器化：新增 .mjs 忘了登记、或在 .ps1 里又
  # 抄一份 KNOWN_FAILED_FILES，都在这里被拦下。
  run "跨平台动作对照(.ps1⇄.mjs)" node scripts/check-ps1-consistency.mjs
  # 端口推导的跨语言一致性（规范 §1.1）：四侧（Node / PowerShell / Python / Rust）读
  # 同一份共享校验向量 tests/fixtures/app-port-vectors.json，任一侧漂移即在此拦下。
  run "端口推导跨语言一致性" node scripts/check-app-port-vectors.cjs
  # import 别名统一（规范 §12.2 / §16.2）：本仓库的别名约定是 `~` 前缀，但
  # tsconfig.json 的 paths 里同时留着 `@/*`（脚手架的历史项）—— 于是 `@/` 也能编译、
  # 也能跑，没有任何反馈，漂移面积自己变大。`shadcn add` 生成的组件默认写 `@/`
  # （§16.3 已点名），src/components/ui/ 因此是重灾区。
  run "import 别名统一(~ 前缀)" node scripts/check-import-alias.cjs --staged
  # 依赖新鲜度（§13.5.13）：只在**你动了依赖面**时判（`--staged`）——
  # 「远端改了库、你还在旧的上面干活」这一档此前没有任何执行者，本轮补上。
  # 全量判会天天红（远端引用普遍陈旧，而刷新人 fetch 是人的动作），每次提交都拿它拦人
  # = 一条天天红的闸，人只会去 skip 它；而「你自己刚改过依赖」这一档不一样 ——
  # 那时「我的基线是不是旧的」必须回答，否则会在旧依赖上解冲突、或把基于旧基线的
  # lockfile 推上去。判据自身**不做网络请求**（远端引用陈旧只打 [未校验]、不阻断）。
  run "依赖新鲜度（只判动了依赖面的提交，§13.5.13）" node scripts/check-deps-freshness.mjs --staged
  # 依赖构建脚本 ⇄ `allowBuilds` 对账（§13.5.15 / AGENTS 硬规则 8）。这条此前**一个执行者
  # 都没有**，而它要防的故障形状是「改动点与故障点不同人、中间还隔一次安装」：
  # 漏登记的人当场看不出来（他自己的 `node_modules` 早装好了，增量 install 甚至
  # short-circuit），第一次复现是下一个人（或另一台检出、另一个容器）跑非交互
  # `pnpm install --frozen-lockfile` 那一刻的 `ERR_PNPM_IGNORED_BUILDS` —— 表现是
  # 「这个仓库装不上依赖」，按硬规则 26 的口径还会被误读成「本机跑不了门禁」。
  # 判据口径照 pnpm 自己那条抄：它按**包名**批准、对名单里没有的构建脚本直接失败而非警告。
  # 所以这里只判「带 preinstall/install/postinstall 的已安装包必须有显式条目」，
  # `true`（批准）与 `false`（显式拒绝）都算回答过；反向（名单里有无脚本的条目）
  # **刻意不判** —— 现状 11 条里 8 条是那种正当形态，判它等于误报一片。
  # 缺 `node_modules/.pnpm` 判红而不是跳过：读不到输入时报绿是 §13.5.12 那一族里最坏的一种。
  # **`--staged` 是输入面跳过**（ISSUE #1747 同族）：能让「带构建脚本的依赖」变化的输入只有
  # 那三个文件（`package.json` / `pnpm-lock.yaml` / `pnpm-workspace.yaml`，清单的出处是
  # `dependency-face.mjs`，与 check-deps-freshness 共用同一份、不在这里抄第二份），
  # 只改文档或只动 `src/` 的提交
  # 扫多少遍结论都一样 —— 全树扫描实测 4.5s（与 check-non-null-assertions 同档），
  # 无条件挂上就是给每个提交白付这笔钱，然后所有人开始 `--no-verify`、判据归零。
  # 跳过时打印「未触及依赖面」，与真扫过的 OK 可分辨；读不到暂存清单走 exit 2 而不是冒充跳过。
  run "依赖构建脚本与 allowBuilds 对账（只判动了依赖面的提交）" node scripts/check-allow-builds.cjs --staged
  # 基础设施层的文件长度棘轮（§12.6 R5 的姊妹档）：R5 / 函数长度 / 非空断言 / 孪生对
  # 四类债务判据的扫描根**都只有 `src`**（`check-file-structure.cjs` 的 R5 定义就写着
  # 「src/ 下超 900 行」，另三份是 `SCAN_DIR = "src"`）。于是判据自己那一层
  # （`scripts/**` 152 份 `.cjs/.mjs` + `tools/**` 26 份 `.ps1`，约 43k 行，与它管的
  # `src` 非测试代码同量级）落在自己立的硬闸之外：`src` 侧超 900 行的基线今天为 0，
  # 同一把尺子在判据层上是 6 个文件、最大一份 4,820 行。
  # 为什么这条值得在提交时响：判据是**被执行的那部分代码** —— 它长到没人读得动的表现
  # 不是报错，而是「这条判据从此恒绿」。同族先例：Rust 壳的函数长度也是「另立脚本」
  # （阈值 120 而不是 400，因为两侧自然长度不同）。
  # 存量已在 ISSUE #1811 第五刀清零，这一档**翻成硬闸**：基线文件与 `--update` 一并
  # 删除，命中即退 1，出口只有一个 —— 拆（§12.6 R5 姊妹档）。
  # 成本实测：读 196 个文件、零网络、零子进程，与 check-app-version / check-a11y-rules 同档。
  # `--staged` 见下 13.5.8.2：暂存改动没碰扫描面时按输入面跳过。
  run "基础设施层文件长度硬闸(scripts+tools，§12.6 R5 姊妹档)" node scripts/check-infra-file-size.cjs --staged
'

# 立刻等这一组 —— 它存在的全部意义就是「在 A/B/C 启动之前先拿到结论」；往下继续并行
# 等于把这一档白拆成第六个后台组（结论照样迟到，只是早几十秒写进一个没人看的日志）。
wait "$D0_pid"
if [ ! -f "$LOGD/D0.rc" ]; then
  # 读不到退出码 ⇒ **拦下**而不是放行：这一档是后面四组的唯一前置，
  # 「判据没跑完」不等于「判据通过」（同 §13.5.15 对「读不到输入时报绿是最坏的一种」的口径）。
  echo "[pre-commit] ✗ 组 D0 没留下退出码（被杀 / 子 shell 没起来？）—— 判据没跑完不等于通过"
  [ -f "$LOGD/D0.log" ] && cat "$LOGD/D0.log"
  echo "[pre-commit] 提交被门槛拦下"
  exit 1
fi
_d0_rc="$(cat "$LOGD/D0.rc")"
if [ "$_d0_rc" != 0 ]; then
  echo "[pre-commit] ✗ 组 D0（形态前置档）失败（退出码 $_d0_rc）—— 其余四组未启动"
  cat "$LOGD/D0.log"
  echo "[pre-commit] 提交被门槛拦下"
  exit 1
fi
# 过了只打一行摘要，与收尾那四组同款（失败才展开整段日志）。
grep -E '^── ' "$LOGD/D0.log" | sed 's/^/  [ok] /'

# ── A/B：类型 + lint（判据独立，并行；沿用 package.json 的 lint 白名单与零警告口径）──
# eslint 的**扫描范围（白名单目录）与参数**收在 package.json 的 `lint` 脚本里 ——
# 门禁、`pnpm lint`、CI 共用同一份，不在这里再抄一遍目录清单（抄一遍就会漂移；
# 范围口径见 eslint.config.js 顶部那节）。
# `--cache --cache-strategy content`（实测，全仓约 964 个代码文件）：
#   · 冷跑/全量重建 311s（默认策略）· 346s（content，仅切换策略后首跑一次）
#   · 稳态热跑 28.8–46.3s
#   · **只碰 mtime、内容不变**：默认 metadata 策略 → 3 条失效、87.5s；
#     content 策略 → **0 条失效**、46.3s
#   · 真改 1 个文件内容：1 条失效、44s
# `--cache-strategy` 默认是 `metadata`（用 mtime + size 判定），于是任何「重写同一
# 份内容」的操作都会把文件判成已变：`git checkout` / `stash` / `pull`、`prettier
# --write`、编辑器保存、构建脚本 touch —— 一次动很多文件就是**大面积失效**。
# 换成 `content`（按内容哈希）后这类抖动不再失效，真实内容改动照常只失效自己那
# 一条。缓存键含「文件内容 + 解析后的 config」，所以改 eslint.config.js 会自然
# 失效；缓存放 node_modules/.cache/eslint（已被 gitignore 覆盖，不必登记忽略清单）。
# 缓存键**不含依赖树**（`no-unsafe-*` 是类型化规则，要看 AST 上的类型），于是依赖一变
# 旧判决会被整片重放 —— 假红会拦住从该缓存起的所有提交，假绿会洗掉新依赖带进来的真
# 违规。这件事以前只有一句 ⚠️「升级 eslint 之后先手动删缓存目录」，靠人记得删 = 没有
# 执行者（且触发面写窄了：真实触发是**任何**依赖变化）。现在按指纹自动失效：由
# `postinstall`（`scripts/install-git-hooks.mjs`）比 `pnpm-lock.yaml` +
# `node_modules/.pnpm/lock.yaml` + `tsconfig.json` 的字节哈希，变了就删该目录
# （ISSUE #1399 / 规范 §13.5.11）。换 cache-location 或 cache-strategy 仍会导致一次
# 全量重建，属预期。
run_group A "tsc --noEmit" sh -c 'pnpm exec tsc --noEmit'
run_group B "eslint（零警告，范围见 package.json lint）" sh -c 'pnpm run lint'

# ── C：结构守护测试（固定清单 + 本次改动牵扯到的用例）──────────────────────
# ⚠️ **2026-10-20 起这一组本地不再执行**：执行者是 `.cnb.yml` 的 `受影响用例` 一格
# （`scripts/ci-affected-tests.mjs` → `run-affected-tests.mjs`，同一条判决链）。
# 理由与边界记在 `run_group()` 里组 C 那段：共享机上它的失效形态是 forks worker
# 调度超时而不是用例红。**这一行留着不删** ——
# `tests/hook-affected-launch.test.ts` 钉的就是入口形状，且它是这份钩子里唯一一处
# 「受影响用例从哪起」的登记。
#
# 固定清单的**唯一出处**是 `scripts/affected-tests.mjs` 的 FIXED_STRUCTURAL_TESTS，
# 这里不再抄一遍：抄一份就会漂移，且清单里的用例被改名后，钩子会「一条都不跑却
# 仍然绿」。增量层的五条判据与它的**已知边界**（不保证传递依赖；命中公共地基时
# 明确放弃收窄、兜底不是全量）写在该脚本文件头与规范 §13.5.8。
#
# 启动那一步交给 `scripts/run-affected-tests.mjs`，不在这里拼 `pnpm exec vitest run $files`：
# 清单是位置参数，长度随改动面线性增长，而 `pnpm exec <bin>` 在 Windows 上经 `.cmd`
# shim —— cmd.exe 的命令行上限 8191 字符。实测一次 22 个文件的提交清单就有 10840 字符，
# vitest 根本没起，stdout 只留一行 GBK 乱码，钩子的表现是「组 C 失败」而看不见任何
# 用例名 —— 那是「判据在场、跑的是 0 个用例」的门禁静默失效。启动器直接用 node
# spawn vitest 的 ESM 入口（不经 cmd 层，上限回到 32767），并按预算分块，
# **宁可多起一次也不丢用例**。`--maxWorkers=4`（只对**钩子里**成立：A(tsc)、B(eslint)、
# D(54 个判据脚本) 与本组并行，再按 `vitest.config.ts` 的 8 起 forks 就会抢不过来 ——
# 现场不是用例红而是 `Failed to start forks worker / Timeout waiting for worker to
# respond`；全量 `pnpm test` 仍是配置里的 8）随启动器一起搬过去了，口径见该脚本文件头。
# ⚠️ 上面那句「D(N 个判据脚本)」的 N 由 `tests/doc-check-hook-wiring.test.ts` 核与钩子里
# `run` 步骤的**总数**一致（D0 那 16 条 + D 那 38 条 = 54），新增判据时必须同步这个数字。
# 严格说与本组**并行**的只有 D 那 38 条：D0 的 16 条在本组启动之前就串行跑完了（见文件头
# 那一档）。拿 54 说并发面积是**偏保守**的那一侧 —— 它高估争抢，而低估争抢才会诱人去抬
# `--maxWorkers`，那正是这一族事故（`Failed to start forks worker`）的方向。
run_group C "结构守护测试（固定清单 + 受影响用例）" sh -c '
  # 先答一格「这台机器上解释器在哪」：几条用到 Python 的用例缺件时按**既有口径**
  # 走 `env` 档跳过并登记（`tests/helpers/python-exe.ts` 的 `hasPython()`），
  # 也就是说它们**不会让本组变红** —— 缺件在日志里是隐身的。
  # 这正是 `check-affected-tests` 报「本次改动牵扯到的 N 个用例里有 X 条被跳过」
  # 时缺的那一半：跳过是事实（C 组照实报），但「跳过的是哪几条、因为什么」此前
  # 只能靠人自己拼。**只打印、不阻断**（判据那一份只有
  # `scripts/ci-toolchain-selfcheck.mjs --python-only` 一个 —— 本钩子不该因为开发机上
  # 没装 Python 而拦住提交，那会把环境缺口变成提交门槛）。
  node scripts/python-probe.mjs || true
  node scripts/run-affected-tests.mjs'

# ── D：其余静态判据（互不依赖；组内串行以控内存，但整体与 A/B/C 并行）──────
# 「组内串行」的实测账见文件头：真钩子档 D 并发收益 ≈0（与 C 抢核）、峰值反而 +0.3GB，
# 所以这里**有意不改并发**；D 组的成本靠「每条判据自己别做无用功」降，不靠并发编排。
# 每条命令的规范出处见 scripts/ 对应脚本头部；顺序即执行序，新增判据追加到这里。
run_group D "静态判据（结构/复用/棘轮/文档）" sh -c '
  set -e
  # 每一步的墙钟落 `$LOGD/steps.ms`（一行 `<标签>=<ms>`，标签原样）—— 「哪一步最贵」
  # 的答案只有逐步骤才有；组级只回答「哪一组最贵」。时钟、追加规则**以及 `run()` 本身**
  # 都收在 `.githooks/timing.sh`：本组是 `sh -c` 起的**新 shell**，外层的函数一个都看不到，
  # 只能 source 同一份（两份时钟必然漂成两个刻度，而账本会把它们并排摆出来）。
  # `run()` 从这一份来而不是在本块里再写一遍：钩子现在有两个这样的块（D0 与 D），
  # 两块的读数必须仍是同一个约定，否则两份账再也不能并排读。
  . "$COMFY_TIMING_SH"
  # R5（超 900 行文件）已是**硬闸**：不带任何 flag，超限即阻断。沿革 = 「只提醒」→
  # ISSUE #1404 加 --strict 棘轮 → ISSUE #1811 基线归零后收成硬闸（`--strict` /
  # `--update` 连同基线一并删除，规范 §12.13.3）。
  # 平台侧流水线删除（ISSUE #623）之后，这一步是它唯一的自动执行者：`check:all`
  # 同样没有自动执行者，§13.5.4 的「按需召唤」只另给一次运行机会、不是判据。
  run "文件结构硬规则(R1-R12，R5 硬闸)" node scripts/check-file-structure.cjs
  # ── AST 判据聚合档（规范 §13.5.8.2「第四笔账」，ISSUE #1747 续）──────────
  # 下面这 6 条判据判的是**同一批文件**（src/** 的 .ts/.tsx，实测 1082 份），此前各自
  # require("typescript") + walk + createSourceFile 全量走一遍。实测 6 个独立进程
  # 3198ms，聚合档（一次解析 + 6×遍历）≈1.3s —— 省的是**计算重复**，不是代码重复。
  # 共享颗粒度是**解析产物**（SourceFile），不是遍历、更不是判定：6 条判据的 main(parsed)
  # 各自照旧跑，聚合档只用 captureProcessExit / captureOutput 接住它们的退出码与输出，
  # 判定代码一行不重写（重写就是孪生实现，漂开的形态是静默的）。
  # 人的动作（--report / --update / --json / --with-tests）仍走**单条脚本** —— 聚合档
  # 只跑钩子档；`--staged` 按条透传，全跳则一次解析都不做。
  # 逐条复验（失败输出里会给出）：node scripts/check-react-updater-purity.cjs 等 6 条。
  # 其中 check-click-keyboard（非原生元素上的「鼠标专属点击」，§6.11）是**硬闸**：
  # 刻意不给「任意 {...spread}」开口 —— `{...props}` / `{...hoverEvents}` 不是键盘
  # 覆盖，只认 `simpleKeyHandler(...)` 这个出口（§16.2.4.57）；结构性站点在
  # `EXEMPT_SITES` 里逐条写理由，`--report` 会把它们打出来（豁免是「认下这一档」，
  # 不是「这一档不存在」）。
  run "AST 判据聚合（6 条共享一次解析）" node scripts/run-ast-gates.cjs --staged
  # 标题行(页签栏)让位：页签搬到窗口标题行后，任何 `fixed inset-0` 的顶层浮层都会
  # 把页签和右上角窗口按钮一起盖住；首轮修复只改了全屏视图、弹窗类漏改。
  run "标题行让位硬规则" node scripts/check-title-bar-clearance.cjs --staged
  # UI 基元复用棘轮（规范 16 §16.2.3）：存量冻结在基线，只许降不许升。
  # `--staged` 同上（ISSUE #1747）：五条扫描根全在 `src/` 下，全库扫描实测 3.6s（热缓存，
  # D 组单项最贵）。未触及扫描面的提交跳过并打印理由。
  run "UI 基元复用棘轮" node scripts/check-ui-primitives.cjs --staged
  # 主题色扫描（规范 03 §3.6.1）：「类型色例外」的豁免清单显式化；豁免后仍有
  # 未 token 化的写死色值即阻断（**硬闸**：存量已清零，无基线、无 --update）。
  run "主题色扫描" node scripts/check-theme-colors.cjs
  # ComfyUI 端口口径一致性（规范 §5）：分叉的表现不是「连不上」，而是静默连到另一个
  # 实例（现象是上传失败/端口漂移）。
  run "ComfyUI 端口口径一致性" node scripts/check-comfyui-port-contract.cjs
  # 视图层不得动态注入 <style>(规范 03 §3.5 / 反模式 T5)。本仓库踩过两次、形态一样
  # （组件私有 CSS 字符串 + 渲染时注入），「自己修完自己写注释」挡不住下一个人。
  run "内联样式注入" node scripts/check-inline-style.cjs --staged
  # 跨文件重复块(规范 12.12)：硬闸 —— 孪生对存量已清零，新增一对即阻断。
  run "跨文件重复块" node scripts/check-code-duplication.cjs --staged
  # 函数长度(规范 12.13)：文件行数由 R5 管,函数没人管 —— 于是 2186 行的单函数一路
  # 合法存在。无名字的块体(IIFE / 回调 / 闭包)与跨行签名同受约束(§12.13.2)。
  run "函数长度(硬闸，>400 行即阻断)" node scripts/check-function-length.cjs --staged
  # Rust 函数长度（规范 12.13）：阈值 120（Rust 是结构化编排，自然长度比 TSX 短）。
  run "Rust 函数长度(硬闸，>120 行即阻断)" node scripts/check-rust-function-length.cjs
  # 桌面壳门禁（规范 §11.10.4 / AGENTS 硬规则 5）：只在暂存改动命中 src-tauri 的四类壳输入
  # 时才做事 —— ① 有 .rs 改动就跑 `cargo test`（壳里 37 条 #[test] 此前唯一的执行者，
  # 全仓没有任何一步跑过它）；② 复用 dev-launcher 的 `shellStaleWarning` 把「改了壳必须
  # 重编」从启动时告警升成本次提交阻断。没碰壳时这一步立刻返回 0，不给普通前端提交加时间。
  run "桌面壳（改了 src-tauri 才跑）" node scripts/shell-gate.mjs
  # 模块循环依赖（规范 12.7）：环的症状是「import 顺序变了就 undefined is not a
  # function」，排查成本极高，因此把「无环」做成**硬闸**（存量已清零）。
  run "模块循环依赖(硬闸)" node scripts/check-circular-deps.cjs --staged
  # 入口包的**重依赖静态可达性**（规范 §12.19 / 02 §2.9）：barrel 里转出一个吃
  # `@xyflow/react` 的模块，而入口静态 import 那个 barrel —— 两件都正常，合起来就是
  # 首屏多下载一整个画布引擎，且**没有任何既有判据会红**（实测入口静态可达 692 个模块、
  # 44 处牵着 `@xyflow/react`）。这条把「入口的静态图上不该有重依赖」机器化，并打印
  # 整条链（红得能直接改）。修法是把 barrel 那一跳换成深路径 + `dynamic()`。
  run "入口重依赖静态可达性" node scripts/check-barrel-heavy-deps.cjs
  # ── prettier 格式硬闸**已挪到平台侧**（`.cnb.yml` 的「prettier 格式」，ISSUE #2010）──
  # 判据一个字没改（`check-format.cjs`），挪的只是执行者。理由与 §13.5.17 那三条文档面
  # 判据同一条口径：**它的结论挡不住任何一次代码回归** —— prettier 只格式化，格式漂了
  # 没有任何运行时症状，最坏后果是下一次 `--write` 产出一份与本次改动无关的全文件
  # diff（§13.7，评审一眼可见、改回来也只是再跑一次格式化）。而它留在**每一次提交**里
  # 的成本是实测的：冷缓存 ~21s、热缓存 ~4.5s（`--staged` 只在「没碰到扫描面」时跳过，
  # 而 `src/**` 是最高频的提交类别，命中即扫全库）。
  # 本地出口照旧在：`pnpm check:all`（`scripts/quality-gate.mjs` 的 `format` 项，全量档）。
  # ⚠️ 紧邻的这一步（`check-reformat-only.cjs`）**必须留着**，两件事别混：那条判的是
  # 「这次提交有没有把真实改动埋进几百个文件的重排里」，后果不可逆（blame 永久失真、
  # squash 合并后本地再没有拆分的机会），而 prettier 那一条判的只是「文件现在干不干净」。
  # 格式化提交与行为改动分离（规范 13.7）：一次提交里「过一遍 prettier 就变成另一种
  # 写法」的文件 ≥ 10 个就阻断，要求拆成两次提交。
  # `--staged` 是**输入面跳过**（ISSUE #1993）：它的面 = 仓库里真实存在的顶层目录与根级
  # 文件名（由 `gate-scan-read.cjs` 的 `discernRoots` 现算，不手抄一份会漂的名单）。
  # 面上真的一份源文件都没有时（典型的 `git commit --allow-empty` 一类「什么都没 staged」），
  # 它本来也只会得出「没有文件改动，跳过」—— 那就不必先把暂存区与 HEAD 各取一遍。
  # 有 `--range` 时脚本自己一律不跳（那档按显式范围判，与暂存区无关）。
  run "格式化提交与行为改动分离" node scripts/check-reformat-only.cjs --staged
  # 翻闸删掉的旗标（`--update` / `--strict`）不许还在被人教着跑（规范 §13.5.16）：
  # 翻硬闸会删掉那两个旗标与基线，而「谁还在说跑那条命令」此前**没有任何判据**——
  # #1845 是人工 grep 一遍清掉 8 处，并把「翻闸时顺手 grep 旧旗标」写成一个**动作**，
  # 而动作没有执行者，下一批翻闸必然再漂。这里把它机器化，但**只做能证明的那一半**：
  # 用法块里教人跑自己的那一行、棘轮归类表的陈词（表里点名 = 断言「仍带 --update」）、
  # 命令清单与红话字面量里 `node scripts/<已翻闸脚本> --update`。沿革叙述（「曾经带
  # --update，已删」）**刻意不判** —— 判它会误报一片，而会误报的判据活不过一次评审。
  run "翻闸旗标的散文承诺(硬闸)" node scripts/check-gate-flag-claims.cjs
  # 生成态文档与源同步（`render-doc-placeholders.cjs --check`，规范 §13.5.5）**已挪到
  # 平台侧**（`.cnb.yml` 的「生成态文档与源同步」，见 §13.5.17）：它判的是「文档生成物
  # 有没有跟着源重渲染」，而**改了文档却忘了重渲染**这件事在本地跑一次就知道
  # （`pnpm doc:render`），没必要让每次提交都为它付一遍重渲染的钱。本地出口：
  # `pnpm doc:render` 后把 `docs/generated/**` 一并提交。
  # API 文档生成物与源同步（`check-docs-api.cjs --staged`，规范 §13.5.5.1）**已挪到
  # 平台侧**（`.cnb.yml` 的「API 文档生成物与源同步」，见 §13.5.17）。挪它的理由与
  # 上面那条同款，但这一条更硬：它的**输入面跳过是必要条件、不是优化** —— 重生成实测
  # **31s**，而 `--staged` 只在「本次暂存碰了 typedoc 输入面」时才做事，于是绝大多数
  # 提交在这上面付的是「读一次暂存清单」的钱，而**它只要真做事就一定是 31s**。
  # 平台侧是全量档：产物形态直接对着「合并后的源码」判，比本地那一档更贴切。
  # 本地出口：`pnpm run docs` 后把 `docs/api/**` 一并提交。
  # 浮层层级刻度（规范 §16.2.5）：Z1/Z2/Z3 三条同为硬闸（刻度之外的裸数字档存量也已
  # 清零，ISSUE #1811 收尾时从棘轮翻上来）。z-index 写错的表现是「时灵时不灵」
  # ——jsdom 不做层叠与命中测试，单测全绿也照样复现，所以判据只能落在源码形态上。
  run "浮层层级刻度硬闸" node scripts/check-overlay-z.cjs --staged
  # src 非空断言 `!` 硬闸（存量已清零）：判据走 TypeScript AST (ts.isNonNullExpression),
  # 不用正则,避免误伤 `!==` / `!x` / 注释里的 `!`。扫描范围是整个 src。
  # 合法例外只有一条道：脚本里的 LEGIT_SITES 逐条登记「下标结构上必然存在」
