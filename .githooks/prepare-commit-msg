#!/bin/sh
# 提交门槛（prepare-commit-msg）：提交信息声明是合并时，本次提交必须真的有两个父。
#
# 为什么在这里而不在 pre-commit：pre-commit **看不到本次的消息** —— 实测
# `COMMIT_EDITMSG` 在 pre-commit 时仍停在**上一条**提交的信息上（git 先跑钩子、
# 后落盘消息）。prepare-commit-msg 收到 `$2`（source），能干净地把 `--amend` 排除
# 在判据之外（amend 的父提交从 HEAD 继承，消息却照样是 Merge…）。
#
# 判据本体在 scripts/check-merge-parents.mjs（规范 §13.6.1 / ISSUE #1594）——
# 本文件只是入口：git 给的是「消息文件路径 + source」，原样透传给判据。
#
# $1 = 消息文件路径，$2 = source（message / template / merge / squash / commit / 空）。
exec node "$(dirname "$0")/../scripts/check-merge-parents.mjs" "$1" "$2"
