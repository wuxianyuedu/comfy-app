# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# ── Better Auth（必填）────────────────────────────
# 下面三项**留空等于没给**：src/env.js 的 createEnv 配了
# emptyStringAsUndefined: true，空串会被判为「缺值」并让启动直接失败
# （报 Invalid environment variables，看不出是「值留空」）。
# 所以直接 `cp .env.example .env` 是**不够**的 —— 跑一次 `pnpm env:init`
# 会自动填好这三项（随机密钥 + 本地 OAuth 占位值），跨平台、无需任何 .ps1。

# Secret used by Better Auth（≥ 32 字符；env:init 生成 64 位随机 hex）
BETTER_AUTH_SECRET=""

# Better Auth GitHub OAuth（本地不跑 OAuth 登录时，占位值即可）
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""

# 数据库（Drizzle + better-sqlite3；相对路径以项目根为基准）
DATABASE_URL="file:./db.sqlite"

# ── 应用端口（可选）───────────────────────────
# 不配置时按「检出路径哈希」稳定推导（同一检出恒定同端口，多份检出并行开发
# 互不冲突，见 launch-and-build.md §1.1 / §1.4）。需要固定端口（例如与其他
# 应用冲突）时取消注释；启动器、Tauri 壳、dev/start 脚本会一致读取，改完
# 重启应用即可。取值范围 1~65535。
# COMFYAPP_PORT="3100"

# ── Workshop MCP（可选）─────────────────────
# MCP HTTP(Streamable) 服务监听端口（默认 4300，避开 dev 回落族 3101/3102）。
# 与 dev server 端口解耦，`pnpm mcp:http` 独立服务；改 COMFYAPP_PORT 不会影响它。
MCP_HTTP_PORT="4300"

# ── 可观测性（可选）────────────────────────────
# pino 日志级别：debug | info | warn | error | fatal
LOG_LEVEL="info"
# Sentry DSN：仅生产接入错误追踪时填写，留空则自动禁用
SENTRY_DSN=""
