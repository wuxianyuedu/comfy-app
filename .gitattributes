# 强制所有文本文件统一使用 LF，跨平台无换行冲突（根治 CRLF 警告）
* text=auto eol=lf

# 显式指定主要文本文件一律 LF
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.rs    text eol=lf
*.ps1   text eol=lf
*.py    text eol=lf

# 二进制文件不转换
*.png   binary
*.jpg   binary
*.ico   binary
*.gif   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
