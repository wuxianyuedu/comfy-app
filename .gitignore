/.local-app-data/
/.local-tmp/

# local caches & logs
/.cache/
.dev-server.log
dev-launcher.log

# workbuddy local project data (memory, not source)
/.workbuddy/

# stray junk / env-specific launchers
/nul
/$null
Comfy-APP
*.bat
