# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# database
db.sqlite
db.sqlite-shm
db.sqlite-wal

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea
# dev logs
*.log
build_log*.txt

# generated & temp
/generated/
/public/generated/
/temp/
/temp/comfy-cli/

# PyInstaller launcher build artifacts
# onedir 模式产物：start-tauri/ 目录（含 start-tauri.exe 与 _internal 依赖）
# 由 scripts/start_tauri_launcher.py 重建，不入库
/start-tauri*/
start-tauri*.exe
# start-tauri*.spec 默认忽略（避免根目录遗留 spec 入库），
# 但 tools/start-tauri.spec 是构建配置，需纳入版本控制：
start-tauri*.spec
!tools/start-tauri.spec
/dist/
/build-launcher*/

# 运行时产物与本地工具(2026-08-29 文件组织审查补充)
/log/
/run/
__pycache__/
/python-venv/

# playwright e2e artifacts
test-results/
playwright-report/

# Storybook 静态产物（`pnpm storybook:build` 生成，不入库）
/storybook-static/

# Storybook 开发期资源与生成件（`scripts/storybook-assets.mjs` 现生成，不入库）：
# 二进制/矢量夹具进 git 会让「改一张测试图」变成一次无法 diff 的提交；
# `generated/` 里是**本检出**的解析链端口，入库必然与别人的 checkout 不符。
/.storybook/assets/
/.storybook/generated/
/src/generated/

# Tauri generated assets (rebuilt by scripts/build-desktop.mjs)
/src-tauri/static/
/src-tauri/binaries/

# 构建后在仓库根生成的启动快捷方式（指向 src-tauri/target/release/app.exe，本地便捷入口，不入库）
*.lnk

# 本机应用设置（含 ComfyUI 路径等，local-only）
/data/

# 代码智能 / 语义检索索引（agent 工具链本地产物，不入版本库）
# codegraph（Rust 内核本地图）
.codegraph/
# zvec-grep（ripgrep+BM25+向量 本地索引）
.zvec-grep/

# agent 工具链本地产物（IDE 会话记忆 / temp / tmp，不入版本库）
.workbuddy/
# ZCode 本地会话产物（规划文件等，与 .workbuddy/ 同类，不入库）
.zcode/
# Qoder 项目本地工作区：默认忽略其内容（Better Harness 评审 canvas/findings/run 产物、
# 每开发者机器各自生成的 IDE 会话/索引/配置），但放行可提交的 project agent 资产
# skills/commands（它们是共享配置，等同 AGENTS.md，应入库）。
.qoder/*
!.qoder/skills/
!.qoder/commands/

# pnpm 本地 store（本环境 store-dir 落在仓库内，不入库）
/.pnpm-store/

# Tauri 构建产物（本地 cargo build / build-desktop.mjs 后生成，不入库）
# Cargo.lock 由每次构建自动更新（依赖图内嵌 sha/时间戳），保持当前入库版本不动
/src-tauri/Cargo.lock
# build.rs 声明 AppManifest 命令后由 tauri-build 自动生成的 ACL 权限文件
/src-tauri/permissions/
