# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# database
db.sqlite
db.sqlite-shm
db.sqlite-wal

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea
# dev logs
*.log
build_log*.txt

# generated & temp
/generated/
/temp/
/temp/comfy-cli/

# PyInstaller launcher build artifacts
# onedir 模式产物：start-tauri/ 目录（含 start-tauri.exe 与 _internal 依赖）
# 由 scripts/start_tauri_launcher.py 重建，不入库
/start-tauri*/
start-tauri*.exe
# start-tauri*.spec 默认忽略（避免根目录遗留 spec 入库），
# 但 tools/start-tauri.spec 是构建配置，需纳入版本控制：
start-tauri*.spec
!tools/start-tauri.spec
/dist/
/build-launcher*/
# 由 scripts/dev_tools_launcher.py 重建，不入库
/dev-tools/
dev-tools*.spec

# 运行时产物与本地工具(2026-08-29 文件组织审查补充)
/log/
/run/
__pycache__/
/python-venv/

# playwright e2e artifacts
test-results/
playwright-report/
/src/generated/

# Tauri generated assets (rebuilt by scripts/build-desktop.mjs)
/src-tauri/static/
/src-tauri/binaries/

# 依赖修复过程中的旧副本（pnpm 策略拒装导致的残缺 node_modules 备份）
/node_modules.old/

# 本机应用设置（含 ComfyUI 路径等，local-only）
/data/

# 代码智能 / 语义检索索引（agent 工具链本地产物，不入版本库）
# codegraph（Rust 内核本地图）
.codegraph/
# zvec-grep（ripgrep+BM25+向量 本地索引）
.zvec-grep/

# agent 工具链本地产物（IDE 会话记忆 / temp / tmp，不入版本库）
.workbuddy/
