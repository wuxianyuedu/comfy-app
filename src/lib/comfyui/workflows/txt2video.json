{
  "1": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model": "__WAN_MODEL__",
      "base_precision": "bf16",
      "quantization": "disabled",
      "load_device": "main_device"
    }
  },
  "2": {
    "class_type": "WanVideoVAELoader",
    "inputs": { "model_name": "__WAN_VAE__", "precision": "bf16" }
  },
  "3": {
    "class_type": "LoadWanVideoT5TextEncoder",
    "inputs": { "model_name": "__T5_MODEL__", "precision": "bf16" }
  },
  "4": {
    "class_type": "WanVideoTextEncode",
    "inputs": {
      "positive_prompt": "__PROMPT__",
      "negative_prompt": "__NEG__",
      "t5": ["3", 0],
      "force_offload": true
    }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": { "image": "__INPUT__" }
  },
  "6": {
    "class_type": "WanVideoImageToVideoEncode",
    "inputs": {
      "vae": ["2", 0],
      "start_image": ["5", 0],
      "width": "__W__",
      "height": "__H__",
      "num_frames": "__FRAMES__",
      "noise_aug_strength": 0.0,
      "start_latent_strength": 1.0,
      "end_latent_strength": 1.0,
      "force_offload": true
    }
  },
  "7": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["1", 0],
      "image_embeds": ["6", 0],
      "text_embeds": ["4", 0],
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "shift": 8,
      "seed": "__SEED__",
      "scheduler": "unipc",
      "riflex_freq_index": 0,
      "force_offload": true
    }
  },
  "8": {
    "class_type": "WanVideoDecode",
    "inputs": {
      "vae": ["2", 0],
      "samples": ["7", 0],
      "enable_vae_tiling": true,
      "tile_x": 256,
      "tile_y": 256,
      "tile_stride_x": 64,
      "tile_stride_y": 64
    }
  },
  "9": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["8", 0],
      "frame_rate": "__FPS__",
      "loop_count": 0,
      "filename_prefix": "__PREFIX__",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
