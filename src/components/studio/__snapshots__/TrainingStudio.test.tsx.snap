                <svg
                  aria-hidden="true"
                  class="lucide lucide-minus"
                  fill="none"
                  height="12"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                  width="12"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M5 12h14"
                  />
                </svg>
              </button>
              <input
                class="min-w-[36px] h-[24px] flex-1 bg-transparent py-0 text-center text-xs font-mono text-gray-200 outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none disabled:opacity-40"
                inputmode="decimal"
                type="text"
                value="0"
              />
              <button
                class="flex h-[24px] w-[24px] shrink-0 items-center justify-center text-gray-500 transition-colors hover:bg-white/6 hover:text-gray-200 active:text-white disabled:opacity-30"
                title="增加 1"
                type="button"
              >
                <svg
                  aria-hidden="true"
                  class="lucide lucide-plus"
                  fill="none"
                  height="12"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                  width="12"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M5 12h14"
                  />
                  <path
                    d="M12 5v14"
                  />
                </svg>
              </button>
            </div>
          </div>
          <button
            class="w-full rounded-xl bg-violet-500 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-violet-400 disabled:opacity-50"
          >
            开始训练
          </button>
          <p
            class="text-center text-[10px] leading-relaxed text-(--color-ink-faintest)"
          >
            全部在本机运行 · 无需登录 · 零授权
          </p>
        </div>
      </aside>
    </div>
    <footer
      class="relative z-10 flex h-6 shrink-0 items-center justify-center gap-2 border-t border-white/4 bg-(--color-panel-deep)/95 backdrop-blur-sm"
    >
      <span
        class="inline-block h-[7px] w-[7px] rounded-full bg-emerald-400 shadow-sm shadow-emerald-400/40"
      />
      <span
        class="text-[11px] text-[#6b788f]"
      >
        ComfyUI·Kohya 就绪 · 本地算力 · 零授权
      </span>
    </footer>
  </div>
</div>
`;
