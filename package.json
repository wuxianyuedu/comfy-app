{
  "name": "Comfy-APP-T3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build && node scripts/standalone-private-inputs.mjs",
    "analyze": "node scripts/analyze-bundle.mjs",
    "check": "pnpm run lint && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "node scripts/db-push.mjs",
    "env:init": "node scripts/env-init.mjs",
    "check:toolchain": "node scripts/check-pnpm-available.mjs",
    "db:studio": "drizzle-kit studio",
    "dev": "node scripts/dev.mjs",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:ratchet": "node scripts/check-format.cjs",
    "format:reformat-guard": "node scripts/check-reformat-only.cjs",
    "lint": "eslint src tests scripts e2e tools *.config.{js,mjs,cjs,ts} --max-warnings 0 --cache --cache-location node_modules/.cache/eslint --cache-strategy content",
    "lint:fix": "pnpm run lint -- --fix",
    "postinstall": "node scripts/install-git-hooks.mjs",
    "preview": "node scripts/start.mjs",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:file": "node scripts/run-tests.mjs",
    "test:full": "node scripts/run-tests.mjs --full",
    "test:e2e": "playwright test",
    "docs": "typedoc",
    "typecheck": "tsc --noEmit",
    "check:all": "node scripts/quality-gate.mjs",
    "check:all:lint": "node scripts/quality-gate.mjs --mode lint",
    "test:coverage": "vitest run --coverage",
    "mcp:stdio": "tsx tools/mcp-stdio.ts",
    "mcp:http": "tsx tools/mcp-http.ts",
    "test:visual": "playwright test e2e/visual",
    "doc:check": "node scripts/check-doc-references.cjs",
    "theme:scan": "node scripts/check-theme-colors.cjs --report",
    "ui:primitives": "node scripts/check-ui-primitives.cjs",
    "ui:overlay-z": "node scripts/check-overlay-z.cjs",
    "ui:overlay-z:report": "node scripts/check-overlay-z.cjs --report",
    "ui:primitives:report": "node scripts/check-ui-primitives.cjs --report",
    "theme:check": "node scripts/check-theme-colors.cjs",
    "doc:render": "node scripts/render-doc-placeholders.cjs",
    "doc:gen": "node scripts/generate-docs.mjs"
  },
  "dependencies": {
