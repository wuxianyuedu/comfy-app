{
  "name": "comfy-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:warm": "node scripts/dev-launcher.js warm",
    "build": "node scripts/prebuild-clean.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "npx prisma db push --accept-data-loss",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "smoke:canvas": "node scripts/canvas-smoke.mjs",
    "parse:custom-nodes": "node scripts/run-parse-custom-nodes.mjs",
    "test:comfy": "tsx scripts/regression.mts",
    "test:comfy:live": "tsx scripts/regression.mts --live",
    "test:comfy:http": "tsx scripts/regression.mts --http",
    "test:r74": "NODE_OPTIONS=\"\" node scripts/r74-subgraph-checkbox.mjs",
    "test:r35": "npx tsx scripts/r35-ardot-io-reorder.mts",
    "test:r36": "npx tsx scripts/r36-ardot-mode-pick-chip.mts",
    "test:r37": "npx tsx scripts/r37-ardot-mode-consistency.mts",
    "test:r38": "npx tsx scripts/r38-ardot-mode-popover.mts",
    "docs:typedoc": "typedoc",
    "docs:gen": "typedoc && echo \"see docs/api/ (generated from TSDoc)\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@xyflow/react": "^12.11.2",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^1.28.0",
    "next": "15.1.6",
    "next-auth": "^5.0.0-beta.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react18-json-view": "^0.2.10",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.12",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.13",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.6",
    "playwright": "^1.62.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
