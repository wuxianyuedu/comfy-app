{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    /* TS7 方向：只允许可擦除语法（禁 enum / namespace / 参数属性）。 */
    "erasableSyntaxOnly": true,
    "checkJs": true,
    /* Bundled projects */
    "lib": ["dom", "dom.iterable", "ES2022"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    /* Path Aliases */
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.js",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "generated",
    "docs",
    "src-tauri/static",
    /* 声明 bundle.resources 之后，tauri build 会把载荷**摆到 exe 旁边**
       （实测 src-tauri/target/release/static/**，resource_dir() 的落点）。
       那里含应用的 TS 源与第三方 .ts，不排除的话 tsc 检查的是构建产物：
       报出来的类型错误指向一份没人维护的副本，改动方向完全看不出来。 */
    "src-tauri/target",
    "temp",
    /* 构建/运行时产物：非源码，且内含第三方 .js（checkJs 会对它们报大量无关错误） */
    "python-venv",
    "start-tauri",
    "dev-tools",
    "build-launcher",
    "dist",
    "coverage",
    "storybook-static",
    "test-results",
    "playwright-report",
    "log",
    "run"
  ]
}
