// Prisma schema for Better Auth
// learn more: https://better-auth.com/docs/concepts/database

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// NOTE: When using mysql or sqlserver, uncomment the //@db.Text annotations in model Account below
// Further reading:
// https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Post {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

model User {
  id            String    @id @default(cuid())
  name          String? //@db.Text
  email         String
  emailVerified Boolean   @default(false)
  image         String? //@db.Text
  // Comfy-APP: local credential login (bcrypt hash; "demo-not-used"/"oauth-not-used" for non-password users)
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  posts         Post[]

  // Comfy-APP business relations
  tasks             Task[]
  favorites         Favorite[]
  workflowTemplates WorkflowTemplate[]
  loraTrainingJobs  LoraTrainingJob[]
  filmProjects      FilmProject[]
  modelConfigs      UserModelConfig[]
  modelTags         WorkflowModelTag[]
  projects          Project[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String? //@db.Text
  userAgent String? //@db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String //@db.Text
  providerId            String //@db.Text
  issuer                String //@db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String? //@db.Text
  refreshToken          String? //@db.Text
  idToken               String? //@db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String? //@db.Text
  password              String? //@db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String //@db.Text
  value      String //@db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// ===== Comfy-APP business models (migrated from original project) =====

model Project {
  id        String   @id // 复用客户端 proj_... id（与 Task.projectId 对齐）
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  nodes     Json     @default("[]") // React Flow Node<CanvasNodeData>[]
  edges     Json     @default("[]") // Edge[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, updatedAt])
}

model Model {
  id           String      @id @default(cuid())
  name         String
  type         String // see src/lib/model-types.ts MODEL_TYPE_META keys
  fileName     String // relative name within `folder` (loadable by ComfyUI)
  folder       String? // ComfyUI model subdir (e.g. "loras"); null for pre-feature rows
  subfolder    String?
  baseModel    String?
  coverUrl     String?
  description  String?
  category     String?
  isAvailable  Boolean     @default(false)
  source       String      @default("LOCAL")
  createdAt    DateTime    @default(now())
  favorites    Favorite[]
  // fileName is unique only *within* a folder (two ComfyUI dirs may share a
  // basename).  trainer.ts registers LoRAs with folder:"loras".
  @@unique([fileName, folder])
  @@index([type])
  @@index([folder])
  @@index([isAvailable])
}

// Per-user model-directory configuration (R-ardot40 / R-ardot41).  Lets the
// user enable / disable ComfyUI directories and add extras.  A single row per
// (user, folder).  `isCustom=false` rows override a MODEL_FOLDERS default
// (e.g. disabled); `isCustom=true` rows are user-added directories.
//
// `types` is the JSON array of ModelType codes this folder's files should be
// offered under (e.g. ["CHECKPOINT","LORA","VAE"] for a "models" dir that
// holds everything).  Empty array → only the row's primary `type`.  Sync
// uses `types[0]` as the chips filter; the COMBO union in the canvas uses
// the full array.
model UserModelConfig {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    String // ComfyUI model subdir name, or a custom folder name
  label     String? // optional display override; defaults to folder name
  type      String // primary ModelType code (see src/lib/model-types.ts)
  types     String   @default("[]") // JSON string[] of ModelType codes this folder supplies
  enabled   Boolean  @default(true)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  @@unique([userId, folder])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId   String
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, modelId])
}

model Task {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // TXT2IMG | IMG2IMG | INPAINT | HIRERES | VIDEO
  prompt         String
  negativePrompt String?
  params         Json
  workflowName   String
  // ── 2026-08-15 方案 B：任务完成时捕获的独立执行快照 ──
  // WorkflowTemplate 是覆盖式单行存储（每次重新导入会整体覆盖 rawJson/graph），
  // 导致历史任务无法精确复现当时实际跑的那一版工作流。故在 Task 行双写一份
  // 执行时捕获的快照，彻底将「任务」与「模板当前版本」解耦。
  // 结构：{ workflow: <executedWorkflow>, capturedAt: <ISO>, source: "execution"|"backfill" }
  workflowSnapshot Json?
  // ── 2026-08-13 项目级产出：把生成结果归属到某个画布项目 ──
  // 关联的是 localStorage 里的 CanvasProject.id（client 侧 `proj_...` 字符串），
  // 没有独立 server 端 project 表，故用普通字符串列。非空时磁盘落点改为
  // public/generated/projects/{projectId}/{taskId}/，便于「按项目归档 + 复现」。
  projectId       String?
  // 本次生成使用到的参考图（img2img/inpaint/i2v/flf 的上游图、首末帧等），
  // 存路径或 url 数组，前端元数据抽屉可直接渲染缩略墙。
  referenceImages Json?
  status         String      @default("QUEUED") // QUEUED | RUNNING | SUCCEEDED | FAILED | CANCELLED
  promptId       String?
  progress       Int         @default(0)
  resultImages   Json?
  logs           Json? // execution log entries (time, level, message)
  error          String?
  // ── 2026-08-17 R-Next：ComfyUI /prompt 的结构化校验错误 ──
  // 当提交的工作流在服务器侧校验失败（"Workflow has N validation error(s)
  // against server"）时，ComfyUI 会在响应里附上结构化的 `node_errors`
  // （按 nodeId 索引，每个含 class_type 与 input_errors[字段名]=message）。
  // 我们把它拆成扁平数组 JSON 存这里，前端直接渲染成可读列表，
  // 无需解析 `error` 里的英文摘要字符串。结构见 src/lib/comfyui/runner.ts
  // 的 ValidationError 类型：[{ nodeId, classType, field, message }]。
  validationErrors String?
  createdAt      DateTime    @default(now())
  finishedAt     DateTime?
  images         TaskImage[]
  @@index([userId, createdAt])
  @@index([projectId])
}

model TaskImage {
  id         String @id @default(cuid())
  taskId     String
  task       Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  localPath  String
  mediaType  String @default("image") // image | video
  seed       String?
  width      Int?
  height     Int?
  isCover    Boolean @default(false)
  sortIndex  Int     @default(0)
}

// User-imported ComfyUI workflows (API format and/or raw UI format).
// `graph` is always API format (object of nodeId -> { class_type, inputs })
// so ComfyUI's /prompt endpoint can execute it directly.
// `rawJson` is the original UI/raw format if the user imported from the
// disk-saved format — we keep it around so users can re-export round-trip.
// `positions` is `{ nodeId: [x, y] }` extracted from rawJson or auto-laid out;
// the editor uses it as the initial ReactFlow layout so workflows look like
// the user arranged them in ComfyUI.
model WorkflowTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  taskType  String   @default("TXT2IMG") // T2I | I2I | INPAINT | T2V | I2V | ...
  // 2026-08-13 多模式支持：一个工作流可挂多个 type。
  // SQLite 不支持 Prisma 标量数组，故 modes 以 JSON 字符串存储（与 Skill.tags 同构）。
  modes       String  @default("[]") // JSON array of mode codes, e.g. ["t2i","i2i","t2i2"]
  defaultMode String? // canonical default mode code; must be one of modes[]
  graph     Json // API format (executable)
  paramMap  Json? // { positiveNode, negativeNode, checkpointNode, samplerNode, inputImageNode } — node ids
  workflowIO Json? // { ioKey: { direction:"input"|"output", kind:"param"|"widget"|"output", nodeId, name } } — exposure selection for subgraph IO editing
  rawJson   Json? // original raw UI format (when imported from disk)
  positions Json? // { nodeId: [x, y] } — for editor initial layout
  // ── Local-file-backed workflow (server reads the file by path) ──
  // When set, the server tracks the on-disk file and re-imports it whenever
  // the file's mtime/checksum changes, so editing the workflow in ComfyUI and
  // saving the same file is reflected on next refresh — no manual re-import.
  sourcePath      String? // absolute local path the workflow was imported from
  sourceChecksum  String? // fast hash of file content at last import (sha1 slice)
  sourceMtime     Int?    // file mtime in SECONDS (epoch) at last import (change detector; seconds fit SQLite 32-bit INT)
  // ── 2026-08-12 R76: marker that the user has explicitly dragged an API
  // JSON onto this workflow (drag-to-upgrade). When set to "user", apiOrigin
  // returns "user" even if rawJson is also present, distinguishing
  // "user-imported API + kept RAW for viewing" from "RAW-derived API".
  // null/empty = legacy row, fall back to the hasApi/hasRaw heuristic.
  apiSource        String? // "user" | null
  // ── 2026-08-15 模型标签（用户级全局标签库，跨工作流复用）──
  // 多对多：一个标签可挂在多个工作流，一个工作流可有多个标签。
  // SQLite 无 Prisma enum/数组，用隐式 m2m 关系承载（自动 join 表）。
  modelTags        WorkflowModelTag[] @relation("WorkflowModelTags")
  createdAt DateTime @default(now())
  @@index([userId])
}

// ── 工作流模型标签库（用户级全局）──
// 用户自定义模型名称（如 "z-image" / "wan2.2"），跨工作流复用；
// 工作流库与画布节点选择器均可按这些标签筛选工作流。
// 同一用户下 name 唯一（大小写不敏感由应用层保证，这里仅保证精确唯一）。
model WorkflowModelTag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  workflows WorkflowTemplate[] @relation("WorkflowModelTags")
  @@unique([userId, name])
  @@index([userId])
}

// ── Skill system ──────────────────────────────────────────────
// Pre-built & user-created style/prompt templates (OpenClaw-inspired).
// Selecting a skill pre-fills prompt, params, and recommended models in CreateStudio.
// ── LLM provider config (singleton) ──────────────────────────
// Stores the user-selected text-generation backend (local Ollama / remote
// OpenAI-compatible API). A single row with id="singleton" is used because the
// app is single-user local. API key is only ever read server-side.
model LlmConfig {
  id               String   @id @default("singleton")
  provider         String   @default("local") // "local" | "remote"
  baseUrl          String   @default("http://localhost:11434/v1")
  model            String   @default("llama3.1")
  apiKey           String? // only needed for remote providers
  temperature      Float    @default(0.7) // 全局默认温度
  temperatureByTask Json?    // 按任务类型覆盖的温度：{"txt2img":0.3,"chat":0.7,...}
  maxTokens        Int      @default(2048)
  updatedAt        DateTime @updatedAt
}

model Skill {
  id              String   @id @default(cuid())
  name            String                          // display name e.g. "皮克斯动画风格"
  slug            String   @unique                 // url-safe id e.g. "pixar-animation"
  description     String                          // one-line description for card subtitle
  icon            String   @default("✨")          // emoji icon
  category        String   @default("style")       // style | video | edit | comic | photo | ...
  promptTemplate  String                          // prompt template (may contain {subject} placeholder)
  negativePrompt  String?                         // default negative prompt
  defaultParams   Json?                           // { steps, cfg, sampler, scheduler, width, height, ... }
  recommendedModel String?                      // preferred checkpoint file name
  tags            String?  @default("[]")         // JSON array of tag strings for search
  coverUrl        String?                         // cover image URL or base64
  isBuiltIn       Boolean  @default(false)        // true = seeded, non-deletable
  sortOrder       Int      @default(0)            // display order within category
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  @@index([category])
  @@index([isActive])
  @@index([isBuiltIn])
}

// ── LoRA 训练（炼丹）任务 ─────────────────────────────
// 本地训练管线：底模 + 触发词 + 数据集图 → 产出 .safetensors LoRA。
// 训练后端可插拔（LORA_TRAINER_URL 指向 Kohya/OneTrainer/ComfyUI 训练节点）。
model LoraTrainingJob {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  baseModel     String // Checkpoint 文件名（必须匹配本机 ComfyUI）
  triggerWord   String // 触发词，如 "somecjkstyle"
  classWord     String? // 类别词，如 "person" / "style" / "concept"
  datasetImages Json // [{ name: string }] 已上传至 ComfyUI input 目录的文件名
  resolution    Int      @default(512)
  steps         Int      @default(1500)
  batchSize     Int      @default(4)
  learningRate  Float    @default(0.0001)
  rankDim       Int      @default(32) // network_dim
  networkAlpha  Int      @default(16) // network_alpha
  optimizer     String   @default("AdamW8bit")
  scheduler     String   @default("cosine")
  seed          Int      @default(0)
  status        String   @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED | CANCELLED
  progress      Int      @default(0)
  outputName    String? // 训练完成后的 LoRA 文件名
  logs          Json? // [{ t, level, msg }]
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([userId, createdAt])
}

// ── 一键成片（Film Studio）──────────────────────────────
// 脚本 / 创意 → 自动分镜 → 逐镜生成视频 → 合成完整影片。
model FilmProject {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  script        String // 原始输入（剧本 / 创意 / 一句话）
  type          String   @default("short_video") // short_video | micro_film | ad | other
  styleSlug     String? // 关联 Skill 风格 slug
  size          String   @default("1280x720") // WxH
  fps           Int      @default(16)
  framesPerShot Int      @default(49)
  subtitleOn    Boolean  @default(true)
  bgmName       String? // 上传到 films/bgm/ 的文件名
  status        String   @default("PARSING") // PARSING | GENERATING | COMPOSING | DONE | FAILED | CANCELLED
  progress      Int      @default(0)
  finalVideo    String? // /generated/films/{id}.mp4
  logs          Json? // [{ t, level, msg }]
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shots         FilmShot[]
  @@index([userId, createdAt])
}

model FilmShot {
  id        String  @id @default(cuid())
  filmId    String
  film      FilmProject @relation(fields: [filmId], references: [id], onDelete: Cascade)
  order     Int
  heading   String? // 场景标题
  prompt    String
  negative  String?
  params    Json? // { frames, fps, size, workflow, steps, cfg, sampler, scheduler }
  taskId    String? // 对应的 ComfyUI 生成任务 id
  status    String  @default("IDLE") // IDLE | QUEUED | RUNNING | SUCCEEDED | FAILED
  progress  Int     @default(0)
  videoPath String? // /generated/{taskId}/vid_0.mp4
  duration  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([filmId, order])
}

// ── 审计日志（生产级安全留痕，见 src/server/lib/audit.ts）──
// 敏感操作（登录失败、删除、导出、设置变更）落库，便于事后溯源与合规。
model AuditLog {
  id        String   @id @default(cuid())
  event     String // login_failed | role_changed | post_deleted | ...
  userId    String?
  ip        String?
  meta      String? // JSON 化的补充信息
  createdAt DateTime @default(now())
  @@index([event])
  @@index([userId])
  @@index([createdAt])
}
